PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=app"
JWT_ACCESS_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Gmail / SMTP Configuration (Recommended)
# To get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="Intelligent Platform <your_email@gmail.com>"

# Resend Email Configuration (Optional Alternative)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=onboarding@resend.dev

# إعدادات GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/github/callback
GITHUB_OAUTH_STATE_TTL_MINUTES=10

# مفتاح تشفير توكن GitHub، 32 بايت بصيغة base64
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

GITHUB_OAUTH_SCOPES=read:user read:org repo
