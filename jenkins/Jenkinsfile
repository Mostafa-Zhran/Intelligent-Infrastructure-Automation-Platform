// ==============================================================================
// Jenkinsfile — Intelligent Infrastructure Automation Platform CI/CD Pipeline
// Implements: PIPE-04 (Checkout), PIPE-05 (Build), PIPE-07 (Deploy), STAT-01 (Status)
// ==============================================================================

pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '10'))
    }

    parameters {
        string(name: 'PROJECT_ID', defaultValue: '', description: 'Unique Project UUID')
        string(name: 'DEPLOYMENT_ID', defaultValue: '', description: 'Unique Deployment UUID')
        string(name: 'REPO_URL', defaultValue: '', description: 'Git clone repository URL')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Target branch name')
        string(name: 'COMMIT_SHA', defaultValue: '', description: 'Exact 40-character commit SHA')
        string(name: 'ENVIRONMENT', defaultValue: 'development', description: 'Target deployment environment')
        string(name: 'DOCKERFILE_PATH', defaultValue: 'Dockerfile', description: 'Relative path to Dockerfile')
        string(name: 'CORRELATION_ID', defaultValue: '', description: 'Distributed tracing correlation ID')
        string(name: 'CALLBACK_URL', defaultValue: '', description: 'Backend status webhook callback URL')
        text(name: 'JOB_PAYLOAD', defaultValue: '', description: 'Full JSON contract payload')
    }

    environment {
        WORKSPACE_DIR = "${WORKSPACE}/src-repo"
        STARTED_AT = ""
    }

    stages {
        stage('Initialize & Pre-Flight Checks') {
            steps {
                script {
                    env.STARTED_AT = new Date().format("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", TimeZone.getTimeZone('UTC'))
                    echo "=========================================================="
                    echo " IIAP Deployment Pipeline Started"
                    echo " Deployment ID:  ${params.DEPLOYMENT_ID}"
                    echo " Project ID:     ${params.PROJECT_ID}"
                    echo " Environment:    ${params.ENVIRONMENT}"
                    echo " Commit SHA:     ${params.COMMIT_SHA}"
                    echo " Correlation ID: ${params.CORRELATION_ID}"
                    echo " Started At:     ${env.STARTED_AT}"
                    echo "=========================================================="

                    // Notify Backend that deployment is RUNNING
                    notifyBackendStatus('RUNNING', null, env.STARTED_AT, null)
                }
            }
        }

        stage('PIPE-04: Repository Checkout') {
            steps {
                script {
                    echo "Executing PIPE-04 Secure Repository Checkout..."

                    withCredentials([
                        string(credentialsId: 'github-access-token', variable: 'GITHUB_TOKEN')
                    ]) {
                        sh '''
                            chmod +x jenkins/scripts/checkout.sh
                            ./jenkins/scripts/checkout.sh \
                                "${REPO_URL}" \
                                "${COMMIT_SHA}" \
                                "${WORKSPACE_DIR}" \
                                "${DOCKERFILE_PATH}"
                        '''
                    }
                }
            }
        }

        stage('PIPE-05: Docker Build & Publish') {
            steps {
                script {
                    echo "Executing PIPE-05 Docker Build and Image Publishing..."

                    // Parse project slug/name from repository URL or project ID
                    def projectName = params.PROJECT_ID
                    if (params.REPO_URL) {
                        def parts = params.REPO_URL.tokenize('/')
                        if (parts.size() > 0) {
                            projectName = parts[-1].replaceAll('\\.git$', '')
                        }
                    }

                    // Optional registry credential binding — degrades gracefully if credentials are not present
                    try {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'container-registry-credentials',
                                usernameVariable: 'REGISTRY_USERNAME',
                                passwordVariable: 'REGISTRY_PASSWORD'
                            )
                        ]) {
                            sh """
                                chmod +x jenkins/scripts/build-and-push.sh
                                ./jenkins/scripts/build-and-push.sh \
                                    "${WORKSPACE_DIR}" \
                                    "${params.DOCKERFILE_PATH}" \
                                    "${projectName}" \
                                    "${params.COMMIT_SHA}" \
                                    "${params.DEPLOYMENT_ID}" \
                                    "${env.REGISTRY_URL ?: ''}"
                            """
                        }
                    } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException e) {
                        echo "Notice: 'container-registry-credentials' not found; proceeding with ambient registry/agent credentials..."
                        sh """
                            chmod +x jenkins/scripts/build-and-push.sh
                            ./jenkins/scripts/build-and-push.sh \
                                "${WORKSPACE_DIR}" \
                                "${params.DOCKERFILE_PATH}" \
                                "${projectName}" \
                                "${params.COMMIT_SHA}" \
                                "${params.DEPLOYMENT_ID}" \
                                "${env.REGISTRY_URL ?: ''}"
                        """
                    }

                    // Archive build metadata for downstream stages and audit
                    if (fileExists('build-metadata.json')) {
                        archiveArtifacts artifacts: 'build-metadata.json', fingerprint: true
                    }
                }
            }
        }

        stage('PIPE-07: Kubernetes Deployment') {
            steps {
                script {
                    echo "PIPE-07: Kubernetes deploy stage placeholder (Next MVP Stage)"
                    // Future: kubectl apply & rollout status check
                }
            }
        }
    }

    post {
        success {
            script {
                def finishedAt = new Date().format("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", TimeZone.getTimeZone('UTC'))
                echo "✓ Pipeline completed successfully."
                notifyBackendStatus('SUCCEEDED', null, env.STARTED_AT, finishedAt)
            }
        }
        failure {
            script {
                def finishedAt = new Date().format("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", TimeZone.getTimeZone('UTC'))
                echo "✗ Pipeline failed. Notifying backend..."
                notifyBackendStatus('FAILED', 'Pipeline failed during execution. Check Jenkins build logs for details.', env.STARTED_AT, finishedAt)
            }
        }
        always {
            // Clean up temporary repository workspace to enforce disk limits and prevent credential persistence
            cleanWs(
                cleanWhenAborted: true,
                cleanWhenFailure: true,
                cleanWhenNotBuilt: true,
                cleanWhenSuccess: true,
                cleanWhenUnstable: true,
                deleteDirs: true
            )
        }
    }
}

// -----------------------------------------------------------------------------
// Helper: Send Status Callback to Backend (STAT-01)
// -----------------------------------------------------------------------------
def notifyBackendStatus(String status, String errorMessage, String startedAt, String finishedAt) {
    if (!params.CALLBACK_URL || params.CALLBACK_URL.trim() == '') {
        echo "No CALLBACK_URL provided. Skipping status notification."
        return
    }

    withCredentials([
        string(credentialsId: 'worker-api-key', variable: 'WORKER_API_KEY')
    ]) {
        def payloadMap = [
            status: status
        ]
        if (errorMessage) payloadMap.errorMessage = errorMessage
        if (startedAt) payloadMap.startedAt = startedAt
        if (finishedAt) payloadMap.finishedAt = finishedAt

        def jsonPayload = readTrustedJson(payloadMap)

        sh """
            curl -s -S -X POST "${params.CALLBACK_URL}" \
                -H "Content-Type: application/json" \
                -H "X-Worker-Api-Key: ${WORKER_API_KEY}" \
                -d '${jsonPayload}' || echo "Warning: Failed to reach backend status callback."
        """
    }
}

// Helper to serialize map to JSON string safely without external libraries
def readTrustedJson(Map map) {
    def builder = new groovy.json.JsonBuilder(map)
    return builder.toString()
}
