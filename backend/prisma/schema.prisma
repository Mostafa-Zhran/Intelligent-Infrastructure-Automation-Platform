  @@index([replaced_by_session_id], map: "refresh_sessions_replaced_by_idx")
  @@index([user_id, revoked_at], map: "refresh_sessions_user_revoked_idx")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                                                              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                            String
  email                                                           String
  password_hash                                                   String
  platform_role                                                   platform_role         @default(USER)
  status                                                          account_status
  created_at                                                      DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                                      DateTime              @default(now()) @db.Timestamptz(6)
  action_approvals                                                action_approvals[]
  action_policies                                                 action_policies[]
  ai_actions                                                      ai_actions[]
  audit_logs                                                      audit_logs[]
  deployments                                                     deployments[]
  project_memberships_project_memberships_added_by_user_idTousers project_memberships[] @relation("project_memberships_added_by_user_idTousers")
  project_memberships_project_memberships_user_idTousers          project_memberships[] @relation("project_memberships_user_idTousers")
  project_roles                                                   project_roles[]
  projects                                                        projects[]
  refresh_sessions                                                refresh_sessions[]
  password_reset_tokens                                           password_reset_tokens[]
  github_connection                                               github_connections?
  github_oauth_states                                             github_oauth_states[]


  @@index([platform_role])
  @@index([status])
  @@schema("app")
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@schema("app")
}

// اتصال جيتهاب المخزن لكل مستخدم، مع توكن مشفر
model github_connections {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @unique @db.Uuid
  github_user_id    String    @db.VarChar(50)
  github_login      String    @db.VarChar(100)
  token_ciphertext  String
  token_iv          String    @db.VarChar(24)
  token_tag         String    @db.VarChar(32)
  token_key_version Int       @default(1)
  token_scopes      String[]  @default([])
  token_expires_at  DateTime? @db.Timestamptz(6)
  connected_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  revoked_at        DateTime? @db.Timestamptz(6)
  revoked_reason    String?
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([github_user_id], map: "github_connections_github_user_idx")
  @@schema("app")
}

// حالة  اواوث مؤقتة، مربوطة بالمستخدم وذات صلاحية قصيرة
model github_oauth_states {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  state_hash String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "github_oauth_states_user_expiry_idx")
  @@schema("app")
}

// حالة إعداد المشروع بعد إنشائه
enum project_setup_status {
  PENDING
  IN_PROGRESS
  READY
  FAILED

  @@schema("app")
}

enum account_status {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@schema("app")
}

enum membership_status {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED

  @@schema("app")
}

enum platform_role {
  USER
  ADMIN

  @@schema("app")
}


