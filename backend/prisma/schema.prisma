/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_approvals {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action_id        String     @db.Uuid
  approver_user_id String?    @db.Uuid
  decision         String
  reason           String?
  payload_hash     String
  policy_version   Int
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  ai_actions       ai_actions @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?     @relation(fields: [approver_user_id], references: [id], onUpdate: NoAction)

  @@index([action_id, created_at(sort: Desc)], map: "action_approvals_action_created_idx")
  @@index([approver_user_id, created_at(sort: Desc)], map: "action_approvals_approver_created_idx")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_policies {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String       @db.Uuid
  environment         String
  action_type         String
  risk_level          String
  requires_approval   Boolean      @default(true)
  required_approvals  Int          @default(1)
  allow_self_approval Boolean      @default(false)
  enabled             Boolean      @default(true)
  policy_version      Int          @default(1)
  created_by_user_id  String?      @db.Uuid
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime     @default(now()) @db.Timestamptz(6)
  users               users?       @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  projects            projects     @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_actions          ai_actions[]

  @@unique([project_id, environment, action_type, risk_level], map: "action_policies_project_env_action_risk_uq")
  @@index([created_by_user_id], map: "action_policies_created_by_idx")
  @@index([project_id, environment, action_type, enabled], map: "action_policies_lookup_idx")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_actions {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id           String              @db.Uuid
  recommendation_id    String?             @db.Uuid
  deployment_id        String?             @db.Uuid
  policy_id            String?             @db.Uuid
  environment          String
  action_type          String
  parameters           Json
  payload_hash         String
  risk_level           String
  status               String              @default("PROPOSED")
  requested_by_user_id String?             @db.Uuid
  policy_decision      Json                @default("{}")
  result               Json?
  error_message        String?
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  updated_at           DateTime            @default(now()) @db.Timestamptz(6)
  started_at           DateTime?           @db.Timestamptz(6)
  finished_at          DateTime?           @db.Timestamptz(6)
  action_approvals     action_approvals[]
  deployments          deployments?        @relation(fields: [deployment_id], references: [id], onUpdate: NoAction)
  action_policies      action_policies?    @relation(fields: [policy_id], references: [id], onUpdate: NoAction)
  projects             projects            @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_recommendations   ai_recommendations? @relation(fields: [recommendation_id], references: [id], onUpdate: NoAction)
  users                users?              @relation(fields: [requested_by_user_id], references: [id], onUpdate: NoAction)

  @@index([deployment_id], map: "ai_actions_deployment_idx")
  @@index([policy_id], map: "ai_actions_policy_idx", where: raw("(policy_id IS NOT NULL)"))
  @@index([project_id, created_at(sort: Desc)], map: "ai_actions_project_created_idx")
  @@index([project_id, status], map: "ai_actions_project_status_idx")
  @@index([recommendation_id], map: "ai_actions_recommendation_idx")
  @@index([requested_by_user_id], map: "ai_actions_requester_idx")
  @@schema("app")
}

