  @@index([deployment_id], map: "ai_recommendations_deployment_idx")
  @@index([project_id, created_at(sort: Desc)], map: "ai_recommendations_project_created_idx")
  @@index([project_id, status], map: "ai_recommendations_project_status_idx")
  @@index([infrastructure_resource_id], map: "ai_recommendations_resource_idx", where: raw("(infrastructure_resource_id IS NOT NULL)"))
